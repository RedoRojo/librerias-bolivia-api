# ==============================================================================
# Configuración del Buscador de Librerías de Bolivia
# ==============================================================================

# Conexión a PostgreSQL (Supabase / Neon / Railway / Local)
# Ejemplo Supabase: postgresql+psycopg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Ejemplo Local: postgresql+psycopg://postgres:password@localhost:5432/libros_bolivia
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/libros_bolivia

# Si es True y PostgreSQL no responde, usa SQLite local en /data/local_books.db automáticamente
USE_SQLITE_FALLBACK=true

# Configuración de los scrapers
CRAWLER_USER_AGENT=LibreriasBoliviaBot/1.0 (+https://librerias-bolivia.com/bot)
RATE_LIMIT_DELAY=1.0
REQUEST_TIMEOUT_SECONDS=15
